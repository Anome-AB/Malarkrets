# Local development template
# Kopiera till .env.local och fyll i värden. .env.local committas aldrig.

# Database — lokal Postgres som dev-stacken kör i docker compose
DATABASE_URL=postgres://malarkrets:malarkrets_dev@localhost:5432/malarkrets

# NextAuth v5 läser AUTH_URL och AUTH_SECRET. NEXTAUTH_* är gamla aliases från
# v4 och behövs inte längre.
AUTH_URL=http://localhost:3000
AUTH_SECRET=dev-secret-change-in-production

# Google Maps — bakas in i client-bundlen vid build. Be Fredrik om dev-nyckeln
# eller skapa en egen i Google Cloud Console (HTTP referrers begränsade till
# localhost). Krävs för platssökning och kartor.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Email (Resend — https://resend.com)
# Tomt = forgotPassword/sendVerificationEmail loggar fel men kraschar inte.
# Sätt din egen Resend-nyckel om du vill testa mail-flödet lokalt.
# onboarding@resend.dev funkar utan domän-verifiering — bra för dev-test.
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev
